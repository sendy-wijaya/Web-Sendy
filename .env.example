# ============================================
# SALIN FILE INI MENJADI ".env" UNTUK PENGEMBANGAN LOKAL
# Untuk deploy di Netlify, isi nilai-nilai ini di:
# Site settings > Environment variables (BUKAN di file ini)
# ============================================

# Didapat dari Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=isi-dengan-service-role-key-supabase

# Login untuk halaman /admin — GANTI dengan milik kamu sendiri
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=gantidenganpasswordkamu

# Kunci rahasia untuk menandatangani sesi login admin
# Isi bebas, asal panjang & acak (minimal 32 karakter)
ADMIN_TOKEN_SECRET=gantidengankunciacaksepanjangminimal32karakter
